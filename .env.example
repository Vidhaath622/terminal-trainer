# Terminal Trainer — environment template
# Copy values into Vercel (`npx vercel env add <NAME>`) and a local .env.local for dev.

# GitHub OAuth app (developer settings → OAuth Apps → New OAuth App)
# Callback URL: http://localhost:3000/api/auth/callback/github (dev)
#            or https://YOUR-PRODUCTION-HOST/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres connection string (neon.tech → project → dashboard)
DATABASE_URL=
