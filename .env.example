# Terminal Trainer — environment template
# Copy values into Vercel (`npx vercel env add <NAME>`) and a local .env.local for dev.

# GitHub OAuth app (developer settings → OAuth Apps → New OAuth App)
# Callback URL: http://localhost:3000/api/auth/callback/github (dev)
#            or https://YOUR-PRODUCTION-HOST/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# openssl rand -base64 32
SESSION_SECRET=

# Neon Postgres connection string (neon.tech → project → dashboard)
DATABASE_URL=

# Server-authoritative roles (comma-separated; everyone else is a student
# with zero authoring capabilities). Logins are case-insensitive.
# These lists are the ONLY way to grant remote authoring rights.
ADMIN_GITHUB_IDS=
ADMIN_LOGINS=
TEACHER_GITHUB_IDS=
TEACHER_LOGINS=

# The owner account — the ONLY identity that can open /admin and call
# /api/admin/* (assign student/teacher to signed-in accounts).
# Find your numeric id: curl https://api.github.com/users/YOUR_LOGIN
OWNER_GITHUB_IDS=
OWNER_LOGINS=
